<%- include('partials/header') -%>
  
<body>
	<%- include('partials/topbar') -%>
	<div class="signupform">
		<input class="usernameinput" type="text" id="username" placeholder="Username">
		<input class="emailinput" type="email" id="email" placeholder="Email">
		<input class="passwordinput" type="password" id="password" placeholder="Password">
		<input class="dobinput" type="date" id="dob" placeholder="Birthday">
		<div class="signupbutton">
			<button onClick="register()" class="registerbutton">Sign up</button>
		</div>
	</div>
</body>

<%- include('partials/footer') -%>